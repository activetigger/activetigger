DATA_PATH="/Users/emilien/Documents/activetigger"

# MODE: dev or prod (alias: production)
MODE=dev
RANDOM_SEED=42
ACTIVETIGGER_USER_HDD_MAX=30
MAX_LOADED_PROJECTS=20
N_WORKERS_GPU=1
N_WORKERS_CPU=5
# celery workers (local dev): broker, API callback target, log level
REDIS_URL=redis://localhost:6379
ORCHESTRATOR_API_URL=http://localhost:5000
WORKER_LOGLEVEL=INFO
# shared secret for the worker callback routes; generated in $DATA_PATH/.task_callback_token when unset
# TASK_CALLBACK_TOKEN=
# lifetime (s) of the redis key flagging a stopped task; must exceed the longest queue wait
# STOP_SIGNAL_TTL=86400
# GPU worker diagnostics: print the stack of the first CUDA initialisation in the worker parent
# TASKMANAGER_TRACE_CUDA_INIT=1
UPDATE_TIMEOUT=1
CPU_ONLY=true
DATABASE_URL="${DATA_PATH}/activetigger.db"
ROOT_PASSWORD
JWT_ALGORITHM=HS256
MAIL_SERVER
MAIL_ACCOUNT
MAIL_PASSWORD