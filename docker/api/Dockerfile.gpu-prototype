ARG PYTHON_VERSION="3.11"
FROM python:${PYTHON_VERSION}

ARG USER_ID=1000
ARG GROUP_ID=1000

RUN groupadd python --gid ${GROUP_ID} \
    && useradd -ms /bin/bash python --uid ${USER_ID} --gid ${GROUP_ID}

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

# Keep dependency installation dynamic at container startup through docker/api/entrypoint.sh.
# This prototype intentionally does not start from an nvidia/cuda base image.
# GPU support depends on the Kubernetes node runtime exposing NVIDIA devices/drivers
# and on uv resolving CUDA-capable Python wheels, especially torch/nvidia-* packages.
ENV UV_PROJECT_ENVIRONMENT=/home/python/venv
ENV MODE=prod
ENV API_PORT=4000
ENV DATA_PATH=/data
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

WORKDIR /api

COPY --chown=python:python api/ /api/
COPY docker/api/entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh \
    && mkdir -p /data/projects/static /data/models \
    && chown -R python:python /data

USER python

EXPOSE 4000

ENTRYPOINT ["/entrypoint.sh"]
